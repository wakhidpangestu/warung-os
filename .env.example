# ===== BROWSER-SAFE (boleh NEXT_PUBLIC_) =====
NEXT_PUBLIC_APP_NAME=WarungOS
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
NEXT_PUBLIC_PAYMENT_MODE_LABEL=mock   # mock | sandbox | live (hanya label UI; server yang memutuskan)

# ===== SERVER-ONLY (JANGAN pernah NEXT_PUBLIC_) =====
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role
AUTH_SECRET=placeholder-random-32-bytes

# Pembayaran
PAYMENT_PROVIDER=mock                 # mock | <provider terpilih>
QRIS_ENABLED=false                    # harus false sampai onboarding merchant selesai
QRIS_API_BASE_URL=
QRIS_API_KEY=
QRIS_WEBHOOK_SECRET=

# Blockchain (testnet saat dev)
AUDIT_MODE=batch                      # per_tx | batch
BLOCKCHAIN_CHAIN_ID=84532             # contoh testnet; verifikasi sebelum dipakai
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_CONTRACT_ADDRESS=
BLOCKCHAIN_SIGNER_SECRET=             # produksi: pakai KMS/secret manager, bukan file

# Cron/worker
CRON_SECRET=placeholder-random
